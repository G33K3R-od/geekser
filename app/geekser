#!/usr/bin/env bash
set -euo pipefail

# Resolve symlinks so ~/.local/bin/geekser can point to a checkout on any drive.
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  LINK_DIR="$(cd -P -- "$(dirname -- "$SOURCE")" && pwd)"
  TARGET="$(readlink -- "$SOURCE")"
  if [[ "$TARGET" = /* ]]; then
    SOURCE="$TARGET"
  else
    SOURCE="$LINK_DIR/$TARGET"
  fi
done
SCRIPT_DIR="$(cd -P -- "$(dirname -- "$SOURCE")" && pwd)"
ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"

PROFILE="${XDG_DATA_HOME:-$HOME/.local/share}/geekser/firefox-profile"
FIREFOX_BIN="${GEEKSER_FIREFOX_BIN:-firefox}"
mkdir -p "$PROFILE/chrome"

if ! command -v "$FIREFOX_BIN" >/dev/null 2>&1; then
  printf 'Geekser requires Firefox. Install firefox or set GEEKSER_FIREFOX_BIN.\n' >&2
  exit 1
fi

if [[ ! -f "$PROFILE/.geekser-initialized" ]]; then
  cp "$ROOT/app/user.js" "$PROFILE/user.js"
  cp "$ROOT/app/userChrome.css" "$PROFILE/chrome/userChrome.css"
  touch "$PROFILE/.geekser-initialized"
fi

HOME_URL="file://$ROOT/app/home/index.html"
exec "$FIREFOX_BIN" --no-remote --profile "$PROFILE" --new-window "$HOME_URL" "$@"
